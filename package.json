{
  "name": "static-api-generator",
  "version": "1.0.0",
  "description": "Build and deploy a static API using Node, TypeScript, eslint, prettier and vitest",
  "type": "module",
  "main": "./build/main.js",
  "exports": "./build/main.js",
  "types": "./build/main.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run format && npm run lint && npm run test",
    "dev": "tsx ./src/import.ts",
    "format": "prettier . --write",
    "lint": "eslint .",
    "start": "node build/main.js",
    "test": "vitest run ./tests/unit",
    "test:integration": "playwright test",
    "test:watch": "vitest ./tests/unit"
  },
  "author": "kmturley",
  "license": "MIT",
  "keywords": [
    "static",
    "api",
    "generator"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16",
    "zod": "^4.3.5"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "crawlee": "^3.15.3",
    "csv": "^6.4.1",
    "glob": "^13.0.0",
    "js-yaml": "^4.1.1",
    "slugify": "^1.6.6",
    "xml-js": "^1.6.11"
  }
}
